# Copy to ".env" and fill in, then: export $(grep -v '^#' .env | xargs)
#
# From your FastPix Dashboard (https://dashboard.fastpix.com):
#   Access Token -> FASTPIX_USERNAME
#   Secret Key   -> FASTPIX_PASSWORD
FASTPIX_USERNAME=
FASTPIX_PASSWORD=

# From Dashboard > Webhooks, used to verify webhook signatures.
FASTPIX_WEBHOOK_SECRET=
